# URL pública del sitio (metadataBase, sitemap, Open Graph).
# En Vercel, si no se define, se usa VERCEL_PROJECT_PRODUCTION_URL automáticamente.
NEXT_PUBLIC_SITE_URL=

# "true" solo cuando el sitio deba indexarse. Por defecto la demo no se indexa.
NEXT_PUBLIC_INDEXABLE=false

# Integración del formulario (pendiente). Solo variables de servidor: nunca NEXT_PUBLIC_.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# FORMSPREE_ENDPOINT=
